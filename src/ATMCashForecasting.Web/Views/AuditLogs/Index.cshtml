@using ATMCashForecasting.Domain.Entities
@model IReadOnlyList<AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<h3 class="mb-3">Audit Logs</h3>
<p class="text-secondary small">Immutable trail of logins, data changes, uploads and forecast runs (most recent 500).</p>

<div class="card">
    <div class="card-body">
        <table id="auditTable" class="table table-striped table-sm w-100">
            <thead>
                <tr><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Entity</th><th>Entity Id</th><th>IP</th><th>Success</th></tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.UserName</td>
                        <td>@log.Action</td>
                        <td>@log.EntityName</td>
                        <td>@log.EntityId</td>
                        <td>@log.IpAddress</td>
                        <td>@(log.IsSuccess ? "✔" : "✘")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$('#auditTable').DataTable({ order: [[0, 'desc']] });</script>
}
