@using ATMCashForecasting.Application.DTOs
@{
    ViewData["Title"] = "Executive Dashboard";
    var kpis = (DashboardKpiDto)ViewBag.Kpis;
    var regional = (IReadOnlyList<RegionalCashSummaryDto>)ViewBag.Regional;
    var riskDistribution = (IReadOnlyList<RiskDistributionDto>)ViewBag.RiskDistribution;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Executive Dashboard</h3>
    <span class="text-secondary small">Last refreshed @DateTime.UtcNow.ToString("u")</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Total ATMs</div>
            <div class="kpi-value">@kpis.TotalAtms</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Active ATMs</div>
            <div class="kpi-value text-success">@kpis.ActiveAtms</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Cash-Out Risk</div>
            <div class="kpi-value text-danger">@kpis.CashOutRiskAtms</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Replenishment Due</div>
            <div class="kpi-value text-warning">@kpis.ReplenishmentDueAtms</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Forecast Accuracy</div>
            <div class="kpi-value">@kpis.ForecastAccuracyPercent.ToString("0.0")%</div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="kpi-card">
            <div class="kpi-label">Total Cash Position</div>
            <div class="kpi-value">@kpis.TotalCashPosition.ToString("C0")</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Regional Cash &amp; Risk Summary</div>
            <div class="card-body">
                <canvas id="regionalChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Risk Distribution</div>
            <div class="card-body">
                <canvas id="riskChart" height="110"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">Forecast Accuracy Trend (Overall)</div>
            <div class="card-body">
                <canvas id="accuracyChart" height="80"></canvas>
                <div class="text-secondary small mt-2">
                    Live per-ATM forecast vs. actual is available on the Forecast Management &rarr; Detail page.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const regionalLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(regional.Select(r => r.RegionName)));
        const regionalCash = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(regional.Select(r => r.TotalCash)));
        const regionalAtRisk = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(regional.Select(r => r.AtRiskCount)));

        new Chart(document.getElementById('regionalChart'), {
            type: 'bar',
            data: {
                labels: regionalLabels,
                datasets: [
                    { label: 'Total Cash', data: regionalCash, backgroundColor: '#0b3d91', yAxisID: 'y' },
                    { label: 'At-Risk ATMs', data: regionalAtRisk, backgroundColor: '#d93025', yAxisID: 'y1', type: 'line' }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: { position: 'left', title: { display: true, text: 'Cash' } },
                    y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'At-Risk Count' } }
                }
            }
        });

        const riskLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(riskDistribution.Select(r => r.RiskLevel.ToString())));
        const riskCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(riskDistribution.Select(r => r.Count)));

        new Chart(document.getElementById('riskChart'), {
            type: 'doughnut',
            data: {
                labels: riskLabels,
                datasets: [{ data: riskCounts, backgroundColor: ['#0f9d58', '#f9ab00', '#e8710a', '#d93025'] }]
            },
            options: { responsive: true }
        });

        new Chart(document.getElementById('accuracyChart'), {
            type: 'line',
            data: {
                labels: [],
                datasets: [
                    { label: 'Forecast', data: [], borderColor: '#0b3d91', tension: 0.3 },
                    { label: 'Actual', data: [], borderColor: '#0f9d58', tension: 0.3 }
                ]
            },
            options: { responsive: true }
        });
    </script>
}
