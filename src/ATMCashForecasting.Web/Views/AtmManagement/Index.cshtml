@{
    ViewData["Title"] = "ATM Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">ATM Management</h3>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createAtmModal">
        <i class="bi bi-plus-lg"></i> Add ATM
    </button>
</div>

<div class="card">
    <div class="card-body">
        <table id="atmTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ATM Code</th>
                    <th>Name</th>
                    <th>Terminal ID</th>
                    <th>Region</th>
                    <th>Branch</th>
                    <th>Type</th>
                    <th>Currency</th>
                    <th>Capacity</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createAtmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createAtmForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add ATM</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-2">
                    <div class="col-6"><label class="form-label">ATM Code</label><input class="form-control" name="atmCode" required /></div>
                    <div class="col-6"><label class="form-label">Terminal ID</label><input class="form-control" name="terminalId" required /></div>
                    <div class="col-12"><label class="form-label">ATM Name</label><input class="form-control" name="atmName" required /></div>
                    <div class="col-6"><label class="form-label">Region ID</label><input type="number" class="form-control" name="regionId" required /></div>
                    <div class="col-6"><label class="form-label">Branch ID</label><input type="number" class="form-control" name="branchId" required /></div>
                    <div class="col-6"><label class="form-label">Latitude</label><input type="number" step="0.000001" class="form-control" name="latitude" required /></div>
                    <div class="col-6"><label class="form-label">Longitude</label><input type="number" step="0.000001" class="form-control" name="longitude" required /></div>
                    <div class="col-6">
                        <label class="form-label">ATM Type</label>
                        <select class="form-select" name="atmType">
                            <option value="1">On-Site</option>
                            <option value="2">Off-Site</option>
                            <option value="3">Through-The-Wall</option>
                            <option value="4">Mobile ATM</option>
                            <option value="5">Cash Recycler</option>
                        </select>
                    </div>
                    <div class="col-6"><label class="form-label">Currency</label><input class="form-control" name="currency" value="USD" maxlength="3" required /></div>
                    <div class="col-6"><label class="form-label">Capacity</label><input type="number" step="0.01" class="form-control" name="capacity" required /></div>
                    <div class="col-6"><label class="form-label">Safety Buffer</label><input type="number" step="0.01" class="form-control" name="safetyBufferAmount" required /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const statusLabels = { 1: 'Active', 2: 'Inactive', 3: 'Offline', 4: 'Under Maintenance', 5: 'Decommissioned' };
        const typeLabels = { 1: 'On-Site', 2: 'Off-Site', 3: 'Through-The-Wall', 4: 'Mobile ATM', 5: 'Cash Recycler' };

        async function loadAtms() {
            const page = await AtmCashApi.call('/api/atm?pageNumber=1&pageSize=500');
            const table = $('#atmTable').DataTable({
                destroy: true,
                data: page.items,
                columns: [
                    { data: 'atmCode' },
                    { data: 'atmName' },
                    { data: 'terminalId' },
                    { data: 'regionName' },
                    { data: 'branchName' },
                    { data: 'atmType', render: t => typeLabels[t] ?? t },
                    { data: 'currency' },
                    { data: 'capacity', render: c => Number(c).toLocaleString(undefined, { style: 'currency', currency: 'USD' }) },
                    { data: 'status', render: s => `<span class="badge ${s === 1 ? 'text-bg-success' : 'text-bg-secondary'}">${statusLabels[s] ?? s}</span>` },
                    { data: 'id', render: id => `<a class="btn btn-sm btn-outline-primary" href="/ForecastManagement/Detail?atmId=${id}">Forecast</a>` }
                ]
            });
        }

        $('#createAtmForm').on('submit', async function (e) {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target).entries());
            ['regionId', 'branchId', 'atmType'].forEach(k => data[k] = parseInt(data[k], 10));
            ['latitude', 'longitude', 'capacity', 'safetyBufferAmount'].forEach(k => data[k] = parseFloat(data[k]));
            try {
                await AtmCashApi.call('/api/atm', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                bootstrap.Modal.getInstance(document.getElementById('createAtmModal')).hide();
                await loadAtms();
            } catch (err) {
                alert('Failed to create ATM: ' + err.message);
            }
        });

        loadAtms();
    </script>
}
