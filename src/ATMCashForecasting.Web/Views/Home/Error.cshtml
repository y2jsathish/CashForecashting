@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <h1 class="display-6">Something went wrong</h1>
    <p class="text-secondary">Request ID: @System.Diagnostics.Activity.Current?.Id</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Dashboard">Return to Dashboard</a>
</div>
