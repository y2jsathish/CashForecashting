@model LoginRequest
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - ATM Cash Forecasting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="card shadow-sm" style="width: 380px;">
        <div class="card-body p-4">
            <div class="text-center mb-3">
                <i class="bi bi-bank2" style="font-size:2.2rem;color:var(--acf-primary);"></i>
                <h4 class="mt-2 mb-0">ATM Cash Forecasting</h4>
                <div class="text-secondary small">&amp; Replenishment Management System</div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2" role="alert">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
                </div>
                <div class="mb-3">
                    <label asp-for="MfaCode" class="form-label">MFA Code <span class="text-secondary">(if enabled)</span></label>
                    <input asp-for="MfaCode" class="form-control" autocomplete="one-time-code" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Sign In</button>
            </form>
            <p class="text-center text-secondary small mt-3 mb-0">Protected by role-based access control &amp; MFA.</p>
        </div>
    </div>
</body>
</html>
