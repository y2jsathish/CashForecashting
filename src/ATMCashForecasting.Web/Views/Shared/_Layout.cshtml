<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ATM Cash Forecasting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg topnav px-3">
        <button class="btn btn-sm btn-outline-secondary me-2" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Dashboard">
            <i class="bi bi-bank2 me-1"></i> ATM Cash Forecasting &amp; Replenishment
        </a>
        <div class="ms-auto d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" id="themeToggle" type="button" title="Toggle dark / light mode">
                <i class="bi bi-moon-stars"></i>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-secondary small d-none d-md-inline">@User.Identity!.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                    <button class="btn btn-sm btn-outline-danger" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            }
        </div>
    </nav>

    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <ul class="nav flex-column py-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="AtmManagement" asp-action="Index"><i class="bi bi-cash-stack"></i> ATM Management</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="ForecastManagement" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Forecast Management</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="ReplenishmentPlanning" asp-action="Index"><i class="bi bi-truck"></i> Replenishment Planning</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="TransactionUpload" asp-action="Index"><i class="bi bi-cloud-upload"></i> Transaction Upload</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reporting" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a></li>
                @if (User.IsInRole(Roles.SystemAdministrator))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-shield-check"></i> Audit Logs</a></li>
                    <li class="nav-item"><a class="nav-link" href="/hangfire"><i class="bi bi-gear"></i> Background Jobs</a></li>
                    <li class="nav-item"><a class="nav-link" href="/swagger"><i class="bi bi-code-slash"></i> API Docs</a></li>
                }
            </ul>
        </aside>

        <main class="content p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js"></script>
    @if (TempData["AcfJwt"] is string jwt)
    {
        <script>sessionStorage.setItem("acf-jwt", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jwt)));</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
